rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function meDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAprovado() {
      return isSignedIn() && meDoc().status == 'aprovado';
    }

    function isAdmin() {
      return isAprovado() && meDoc().role == 'admin';
    }

    // gestor = admin ou planejador: monta o planejamento e acompanha tudo.
    // Só o admin aprova usuários e muda papéis.
    function isGestor() {
      return isAprovado() && meDoc().role in ['admin', 'planejador'];
    }

    // permissão por contrato: lista vazia (ou ausente) = todos os contratos
    function meusContratos() {
      return meDoc().get('contratos', []);
    }

    function podeVerContrato(contratoId) {
      return isGestor() || meusContratos().size() == 0 || contratoId in meusContratos();
    }

    function texto(v, max) {
      return v is string && v.size() <= max;
    }

    // administrador principal: conta fixa, que ninguém bloqueia, rebaixa,
    // apaga ou altera pelo app (só pelo console do Firebase)
    function ehPrincipal(uid) {
      return exists(/databases/$(database)/documents/config/admin)
        && get(/databases/$(database)/documents/config/admin).data.principal == uid;
    }

    // ---------------------------------------------------------------
    // usuarios — cada pessoa lê o próprio perfil; só o admin lê a lista,
    // aprova, nega ou muda papéis/contratos. O cadastro nasce sempre como
    // "pendente" e "lider" — é isso que impede autoaprovação. A conta do
    // administrador principal não pode ser alterada nem apagada pelo app.
    // A própria pessoa só pode marcar que já trocou a senha provisória.
    // ---------------------------------------------------------------
    match /usuarios/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.role == 'lider'
        && texto(request.resource.data.nomeCompleto, 120)
        && request.resource.data.nomeCompleto.size() >= 3
        && request.resource.data.matricula is string
        && request.resource.data.matricula.matches('[0-9]{6}');
      allow update: if (isAdmin()
          && !ehPrincipal(uid)
          && request.resource.data.role in ['lider', 'planejador', 'admin']
          && request.resource.data.status in ['pendente', 'aprovado', 'negado'])
        || (isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trocarSenha'])
          && request.resource.data.trocarSenha == false);
      allow delete: if isAdmin() && !ehPrincipal(uid);
    }

    // ---------------------------------------------------------------
    // catálogo e planejamento — todo aprovado lê (o apontador precisa do
    // planejado em campo); só admin/planejador escreve.
    // ---------------------------------------------------------------
    match /colaboradores/{id} {
      allow read: if isAprovado();
      allow write: if isAdmin();
    }

    match /atividades/{id} {
      allow read: if isAprovado();
      allow write: if isGestor() && texto(request.resource.data.nome, 200);
      allow delete: if isGestor();
    }

    match /setores/{id} {
      allow read: if isAprovado();
      allow write: if isGestor();
    }

    match /clientes/{id} {
      allow read: if isAprovado();
      allow write: if isGestor();
    }

    match /contratos/{id} {
      allow read: if isAprovado();
      allow write: if isGestor();
    }

    // o apontador com contratos definidos só enxerga os projetos deles
    match /projetos/{id} {
      allow read: if isAprovado() && podeVerContrato(resource.data.contratoId);
      allow write: if isGestor();
    }

    // ---------------------------------------------------------------
    // lancamentos — cada apontador cria e mantém os seus; admin/planejador
    // acessam todos. O servidor recusa formatos inválidos e não deixa
    // trocar o dono de um lançamento.
    // ---------------------------------------------------------------
    function lancamentoValido(d) {
      return d.data is string && d.data.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.horaInicio is string && d.horaInicio.matches('[0-9]{2}:[0-9]{2}')
        && d.horaTermino is string && d.horaTermino.matches('[0-9]{2}:[0-9]{2}')
        && d.duracaoMinutos is number && d.duracaoMinutos >= 0 && d.duracaoMinutos <= 1440
        && d.tipoRegistro in ['atividade', 'improdutividade']
        && texto(d.get('observacoes', ''), 2000)
        && texto(d.get('justificativa', ''), 2000)
        && texto(d.get('atividadeNome', ''), 300);
    }

    // lançamento num projeto só nos contratos permitidos (avulso é livre)
    function projetoPermitido(d) {
      return d.get('projetoId', '') == ''
        || isGestor()
        || meusContratos().size() == 0
        || get(/databases/$(database)/documents/projetos/$(d.projetoId)).data.contratoId in meusContratos();
    }

    match /lancamentos/{id} {
      allow read: if isAprovado() && (isGestor() || resource.data.criadoPorUid == request.auth.uid);
      allow create: if isAprovado()
        && request.resource.data.criadoPorUid == request.auth.uid
        && lancamentoValido(request.resource.data)
        && projetoPermitido(request.resource.data);
      allow update: if isAprovado()
        && (isGestor() || resource.data.criadoPorUid == request.auth.uid)
        && request.resource.data.criadoPorUid == resource.data.criadoPorUid
        && lancamentoValido(request.resource.data);
      allow delete: if isAprovado()
        && (isGestor() || resource.data.criadoPorUid == request.auth.uid);
    }

    // estudos de tempos — quem faz é dono; admin/planejador veem e mantêm todos
    match /estudos/{id} {
      allow read: if isAprovado() && (isGestor() || resource.data.criadoPorUid == request.auth.uid);
      allow create: if isAprovado()
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.tipo in ['cronoanalise', 'amostragem', 'mtm', 'takt', 'historico'];
      allow update: if isAprovado()
        && (isGestor() || resource.data.criadoPorUid == request.auth.uid)
        && request.resource.data.criadoPorUid == resource.data.criadoPorUid;
      allow delete: if isAprovado()
        && (isGestor() || resource.data.criadoPorUid == request.auth.uid);
    }

    // ---------------------------------------------------------------
    // auditoria — só acrescenta: ninguém edita nem apaga um registro
    // ---------------------------------------------------------------
    match /auditoria/{id} {
      allow read: if isGestor();
      allow create: if isAprovado()
        && request.resource.data.uid == request.auth.uid
        && texto(request.resource.data.resumo, 300);
      allow update, delete: if false;
    }

    // saúde do app — qualquer usuário logado registra falhas/recuperações
    // dele mesmo; só admin/planejador leem (e podem limpar)
    match /saude/{id} {
      allow read, delete: if isGestor();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tipo in ['erro', 'recuperacao']
        && texto(request.resource.data.mensagem, 300)
        && texto(request.resource.data.get('pilha', ''), 1500);
      allow update: if false;
    }

    // quem é o administrador principal: definido uma única vez, pelo próprio
    // admin; depois disso só muda pelo console do Firebase
    match /config/admin {
      allow read: if isAprovado();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['principal', 'definidoEm'])
        && request.resource.data.principal == request.auth.uid;
      allow update, delete: if false;
    }

    // configurações do sistema (ex.: data do último backup)
    match /config/{id} {
      allow read, write: if isGestor() && id != 'admin';
    }
  
    // ===============================================================
    // PRIMÁRIAS (app reframax-primarias). Mesmas contas do T&M; o acesso
    // e o papel ficam em prim_usuarios: lider, planejador, admin, gestor.
    // O administrador aprovado do T&M é administrador aqui também.
    // ===============================================================
    function tmAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.status == 'aprovado';
    }
    function primMe() {
      return get(/databases/$(database)/documents/prim_usuarios/$(request.auth.uid)).data;
    }
    function primAprovado() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/prim_usuarios/$(request.auth.uid))
        && primMe().status == 'aprovado';
    }
    function primAdmin() { return (primAprovado() && primMe().papel == 'admin') || tmAdmin(); }
    function primGestao() { return (primAprovado() && primMe().papel in ['admin', 'planejador']) || tmAdmin(); }
    // quem lança avanço e tira fotos (o gestor só olha)
    function primCampo() { return (primAprovado() && primMe().papel in ['lider', 'planejador', 'admin']) || tmAdmin(); }
    function primLeitura() { return primAprovado() || tmAdmin(); }
    function primAutor(d) { return d.autor.uid == request.auth.uid; }
    function dataValida(v) { return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'); }

    match /prim_usuarios/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || primLeitura());
      allow list: if primAdmin();
      // cadastro: nasce líder pendente; o admin do T&M pode se liberar como admin
      allow create: if isSignedIn() && request.auth.uid == uid
        && texto(request.resource.data.nome, 120)
        && request.resource.data.matricula is string
        && request.resource.data.matricula.matches('[0-9]{6}')
        && ((request.resource.data.papel == 'lider' && request.resource.data.status == 'pendente')
          || (tmAdmin() && request.resource.data.papel == 'admin' && request.resource.data.status == 'aprovado'));
      allow update: if (primAdmin() && request.auth.uid != uid
          && request.resource.data.papel in ['lider', 'planejador', 'admin', 'gestor']
          && request.resource.data.status in ['pendente', 'aprovado', 'negado'])
        || (isSignedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trocarSenha'])
          && request.resource.data.trocarSenha == false);
      allow delete: if primAdmin() && request.auth.uid != uid;
    }

    function primLancamentoValido(d) {
      return d.etapa in ['andaime', 'demolicao', 'assentamento', 'injetbar', 'massa1200', 'desmontagem']
        && dataValida(d.data)
        && d.prims is list && d.prims.size() > 0 && d.prims.size() <= 900
        && d.status in ['valido', 'cancelado']
        && texto(d.get('obs', ''), 1000);
    }
    match /prim_lancamentos/{id} {
      allow read: if primLeitura();
      allow create: if primCampo() && primAutor(request.resource.data)
        && request.resource.data.status == 'valido'
        && primLancamentoValido(request.resource.data);
      // só o planejador/admin altera (cancela ou troca o dia); o autor não muda
      allow update: if primGestao()
        && request.resource.data.autor.uid == resource.data.autor.uid
        && primLancamentoValido(request.resource.data);
      allow delete: if false;
    }

    match /prim_correcoes/{id} {
      allow read: if primLeitura();
      allow create: if primCampo() && primAutor(request.resource.data)
        && request.resource.data.status == 'pendente'
        && texto(request.resource.data.motivo, 1000);
      allow update: if primGestao();
      allow delete: if false;
    }

    match /prim_ocorrencias/{id} {
      allow read: if primLeitura();
      allow create: if primCampo() && primAutor(request.resource.data)
        && dataValida(request.resource.data.data)
        && texto(request.resource.data.texto, 2000);
      allow update: if primGestao()
        || (primCampo() && primAutor(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if false;
    }

    // fotos do checklist: imagem comprimida dentro do documento (até ~1 MB)
    match /prim_fotos/{id} {
      allow read: if primLeitura();
      allow create, update: if primCampo()
        && request.resource.data.fornoId is string
        && request.resource.data.slot is string
        && request.resource.data.imagem is string
        && request.resource.data.imagem.size() < 1000000
        && primAutor(request.resource.data)
        && (resource == null
          || !exists(/databases/$(database)/documents/prim_checklists/$(request.resource.data.fornoId))
          || get(/databases/$(database)/documents/prim_checklists/$(request.resource.data.fornoId)).data.get('status', '') != 'aprovado');
      allow delete: if primGestao();
    }

    // checklist: o campo junta as fotos e envia; só o planejador/admin aprova
    // (e só ele numera)
    match /prim_checklists/{fornoId} {
      allow read: if primLeitura();
      allow write: if primGestao()
        || (primCampo()
          && (resource == null || resource.data.get('status', '') != 'aprovado')
          && request.resource.data.get('status', 'rascunho') in ['rascunho', 'enviado', 'devolvido']
          && ((resource == null && request.resource.data.get('numero', null) == null)
            || (resource != null && request.resource.data.get('numero', null) == resource.data.get('numero', null))));
    }

    // RDO: o planejador monta e fecha; o campo não mexe
    match /prim_rdos/{data} {
      allow read: if primLeitura();
      allow write: if primGestao();
    }

    match /prim_desvios/{data} {
      allow read: if primLeitura();
      allow write: if primGestao();
    }

    // configuração (meta, pesos, último RDO), base da planilha e contadores
    match /prim_config/{id} {
      allow read: if primLeitura();
      allow write: if primGestao();
    }
  }
}
