# Copie para functions/.env e preencha. Segredos (chaves) NÃO vão aqui: use
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set META_APP_SECRET
#   firebase functions:secrets:set TOKEN_KEY      (gere com: openssl rand -base64 32)
