{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/meta/retorno", "function": { "functionId": "metaRetorno", "region": "southamerica-east1" } }
    ],
    "headers": [
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  },
  "functions": [
    { "source": "functions", "codebase": "pulso", "runtime": "nodejs22", "ignore": ["node_modules", ".git", "*.local", "teste-offline.js", "verificar.js"] }
  ],
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" }
}
