# Sem estas variáveis o Pulso abre em MODO DEMONSTRAÇÃO (tudo local, no navegador).
# Preencha com o firebaseConfig do seu projeto para ligar o modo real.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Região das Cloud Functions (a mesma do deploy em functions/)
VITE_FUNCTIONS_REGION=southamerica-east1
